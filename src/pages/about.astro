---
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="关于 · 花花有期" description="关于花花，也关于这本持续生长的个人刊物。" /></head>
	<body>
		<Header />
		<main class="about">
			<div class="rule"><span>ABOUT THE EDITOR</span><span>关于我</span></div>
			<section class="intro">
				<div><p class="kicker">你好，我是</p><h1>花花。</h1></div>
				<p class="lede">我在这里写生活、记忆、远方，以及一些很难被归类的瞬间。比起“输出观点”，我更想保存感受。</p>
			</section>
			<section class="portrait">
				<Image src={AboutHeroImage} alt="花花的个人影像" widths={[720, 1280]} />
				<div class="caption"><span>PORTRAIT / 2026</span><span>中国 · CHINA</span></div>
			</section>
			<section class="story">
				<aside>01<br />A SMALL<br />INTRODUCTION</aside>
				<div><h2>这不是个人简介，<br />更像一封开场白。</h2><p>这个博客会慢慢长成一本属于我的数字杂志。它可能有认真写完的散文，也会有只记录一阵风、一次散步或一顿晚饭的短篇。照片不是配图，而是另一种语言。</p><p>我喜欢纸张、留白、旧书页和杂志里那些大胆的排版，也喜欢屏幕能做到的微妙动态。这里会是它们相遇的地方。</p><blockquote>“愿我们保持具体，保持感受，也保持对生活的好奇。”</blockquote></div>
			</section>
			<section class="contact"><p class="kicker">KEEP IN TOUCH</p><h2>如果你也喜欢<br />缓慢而诚实的表达。</h2><a href="mailto:hello@example.com">写信给我 / SAY HELLO ↗</a></section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about{width:100%;max-width:1280px;padding:2rem}.rule{display:flex;justify-content:space-between;padding:.5rem 0;border-top:1px solid var(--fg);border-bottom:3px double var(--fg);font:.6rem var(--font-mono);letter-spacing:.16em;color:var(--fg-muted)}
	.intro{display:grid;grid-template-columns:1.2fr 1fr;gap:4rem;align-items:end;padding:5rem 0 3rem}.kicker{margin:0 0 1rem;color:var(--accent);font:600 .62rem var(--font-mono);letter-spacing:.18em}.intro h1{font-size:clamp(4.2rem,10vw,8rem);line-height:.82;letter-spacing:-.06em}.lede{max-width:30rem;margin:0;font-size:clamp(1.15rem,2vw,1.65rem);line-height:1.6}
	.portrait{margin:0}.portrait :global(img){display:block;width:100%;max-height:75vh;object-fit:cover;border-radius:0;filter:saturate(.75)}.caption{display:flex;justify-content:space-between;padding:.55rem 0;color:var(--fg-muted);font:.55rem var(--font-mono);letter-spacing:.14em}
	.story{display:grid;grid-template-columns:180px minmax(0,700px);justify-content:center;gap:3rem;padding:6rem 0}.story aside{color:var(--accent);font:.6rem/1.7 var(--font-mono);letter-spacing:.14em}.story h2{font-size:clamp(2rem,4vw,3.2rem)}.story p{font-size:1.02rem;line-height:1.95}.story blockquote{margin-top:2.5rem;font-size:1.3rem}
	.contact{margin-bottom:5rem;padding:clamp(2rem,6vw,5rem);background:var(--fg);color:white}.contact h2{color:white;font-size:clamp(2.2rem,5.5vw,4.5rem)}.contact a{color:var(--accent);font:.65rem var(--font-mono);letter-spacing:.14em}
	@media(max-width:700px){.about{padding:1.2rem 1.1rem 3rem}.intro{grid-template-columns:1fr;gap:2rem;padding:3rem 0 2rem}.story{grid-template-columns:1fr;gap:1.5rem;padding:4rem 0}.contact{margin-bottom:2rem}}
</style>
