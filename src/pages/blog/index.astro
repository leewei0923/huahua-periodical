---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import QiniuImage from '../../components/QiniuImage.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getPublishedPosts } from '../../lib/publications';
const posts = getPublishedPosts(await getCollection('blog'));
const allTopics = [...new Set(posts.flatMap((post) => post.data.topics))];
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="文章 · 花花有期" description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="archive">
			<header class="archive-head">
				<div class="head-rule"><span>ARCHIVE / 文章存档</span><span>{posts.length} STORIES</span></div>
				<h1>所有写下的<br />与未写完的</h1>
				<p>生活随笔、散文、照片与偶尔的技术漫游。<br /><em>Essays, field notes, photographs and unfinished thoughts.</em></p>
			</header>
			<div class="filters" aria-label="文章筛选"><button class="active" data-filter="all">全部 ALL</button>{allTopics.map((topic) => <button data-filter={topic}>{topic}</button>)}</div>
			<section class="post-list">
				{posts.map((post, index) => <article data-lang={post.data.language} data-tags={post.data.topics.join(' ')}>
					<a class="thumb" href={`/blog/${post.id}/`}>{post.data.heroImage && <QiniuImage {...post.data.heroImage} alt="" sizes="(max-width: 700px) 100vw, 28vw" />}</a>
					<div class="number">{String(index + 1).padStart(2, '0')}</div>
					<div class="post-copy"><div class="meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.language.toUpperCase()}</span><span>{post.data.issueOverride ?? 'HUĀHUĀ PERIODICAL'}</span></div><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
					<a class="arrow" href={`/blog/${post.id}/`} aria-label={`阅读 ${post.data.title}`}>↗</a>
				</article>)}
			</section>
			<p class="empty" hidden>这一栏暂时还是空白，等下一篇文章。 / Nothing here yet.</p>
		</main>
		<Footer />
		<script>
			const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
			const stories = [...document.querySelectorAll<HTMLElement>('.post-list article')];
			const empty = document.querySelector<HTMLElement>('.empty');
			function filterStories(filter = 'all') {
				let visible = 0;
				stories.forEach((story) => {
					const match = filter === 'all' || story.dataset.tags?.split(' ').includes(filter);
					story.hidden = !match;
					if (match) visible++;
				});
				buttons.forEach((button) => button.classList.toggle('active', button.dataset.filter === filter));
				if (empty) empty.hidden = visible > 0;
			}
			const initialTag = new URLSearchParams(location.search).get('tag');
			buttons.forEach((button) => button.addEventListener('click', () => {
				filterStories(button.dataset.filter);
				const url = new URL(location.href);
				if (button.dataset.filter === 'all') url.searchParams.delete('tag');
				else url.searchParams.set('tag', button.dataset.filter);
				history.replaceState(null, '', url);
			}));
			if (initialTag && buttons.some((button) => button.dataset.filter === initialTag)) {
				filterStories(initialTag);
			} else {
				filterStories('all');
			}
		</script>
	</body>
</html>

<style>
	.archive { width: 100%; max-width: 1280px; padding: 2rem; }
	.head-rule { display: flex; justify-content: space-between; padding: .58rem 0; border-top: 1px solid var(--fg); border-bottom: 3px double var(--fg); font: .68rem var(--font-mono); letter-spacing: .1em; color: var(--fg-muted); }
	.archive-head { display: grid; grid-template-columns: 1.5fr 1fr; align-items: end; gap: 3rem; }
	.archive-head .head-rule { grid-column: 1/-1; }
	.archive-head h1 { margin: 2.5rem 0 3.5rem; font-size: clamp(3.2rem, 7vw, 6rem); line-height: .96; letter-spacing: -.025em; }
	.archive-head p { margin-bottom: 4rem; color: var(--fg-muted); font-size: 1.08rem; }.archive-head em { font-size: .92rem; }
	.filters { display: flex; gap: .55rem; padding: 1rem 0; border-top: 1px solid var(--border-strong); }
	.filters button { padding: .58rem .82rem; color: var(--fg-muted); background: transparent; border: 1px solid var(--border); font: .72rem var(--font-mono); letter-spacing: .08em; cursor: pointer; }.filters button:hover,.filters .active { color: white; background: var(--accent); border-color: var(--accent); }
	.post-list { border-top: 3px double var(--fg); }
	.post-list article[hidden] { display: none !important; }
	.empty { padding: 4rem 0; color: var(--fg-muted); text-align: center; }
	article { display: grid; grid-template-columns: 168px 45px minmax(0, 860px) 32px; gap: 1.75rem; align-items: center; padding: 1.9rem 0; border-bottom: 1px solid var(--border-strong); }
	.thumb { display: grid; place-items: center; aspect-ratio: 3/4; overflow: hidden; padding: .65rem; background: color-mix(in srgb, var(--border) 58%, var(--bg)); }.thumb :global(img) { width:100%; height:100%; object-fit:contain; filter:saturate(.7); box-shadow:0 8px 22px rgba(20,20,20,.13); transition: .5s var(--ease); }.thumb:hover :global(img){transform:scale(1.025);filter:saturate(1)}
	.number { color: var(--accent); font: .72rem var(--font-mono); align-self: start; }
	.meta { display:flex; flex-wrap:wrap; gap:1rem; color:var(--fg-muted); font:.68rem var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
	h2 { margin: .4rem 0; font-size: clamp(1.45rem, 2.4vw, 2.05rem); letter-spacing: -.01em; }h2 a { color:inherit;text-decoration:none; }article p{margin:0;color:var(--fg-muted);font-size:.98rem;line-height:1.75;}
	.arrow{color:var(--accent);font-size:1.35rem;text-decoration:none;}
	@media(max-width:700px){.archive{padding:1.2rem 1.1rem 4rem}.archive-head{grid-template-columns:1fr}.archive-head h1{margin:2rem 0 0;font-size:clamp(2.8rem,14vw,4rem)}.archive-head p{margin:0 0 2rem}.filters{overflow-x:auto}.filters button{white-space:nowrap}article{grid-template-columns:48px 1fr auto;gap:.8rem;padding:2rem 0}.thumb{grid-column:1/-1;width:min(72vw,280px);justify-self:center}.number{grid-column:1}.post-copy{grid-column:2}.arrow{grid-column:3}article p{display:none}}
</style>
