---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getPublishedPosts } from '../../lib/publications';
const posts = getPublishedPosts(await getCollection('blog'));
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="文章 · 花花有期" description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="archive">
			<header class="archive-head">
				<div class="head-rule"><span>ARCHIVE / 文章存档</span><span>{posts.length} STORIES</span></div>
				<h1>所有写下的<br />与未写完的</h1>
				<p>生活随笔、散文、照片与偶尔的技术漫游。<br /><em>Essays, field notes, photographs and unfinished thoughts.</em></p>
			</header>
			<div class="filters" id="languages" aria-label="文章筛选"><button class="active" data-filter="all">全部 ALL</button><button data-filter="essay">随笔 ESSAY</button><button data-filter="life">生活 LIFE</button><button data-filter="zh">中文 ZH</button><button data-filter="en">英文 EN</button></div>
			<section class="post-list">
				{posts.map((post, index) => <article data-lang={post.data.lang} data-tags={post.data.tags.join(' ')}>
					<a class="thumb" href={`/blog/${post.id}/`}>{post.data.heroImage && <Image src={post.data.heroImage} alt="" widths={[320, 560]} sizes="(max-width: 700px) 100vw, 28vw" />}</a>
					<div class="number">{String(index + 1).padStart(2, '0')}</div>
					<div class="post-copy"><div class="meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.lang.toUpperCase()}</span><span>{post.data.issue ?? 'HUĀHUĀ PERIODICAL'}</span></div><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
					<a class="arrow" href={`/blog/${post.id}/`} aria-label={`阅读 ${post.data.title}`}>↗</a>
				</article>)}
			</section>
			<p class="empty" hidden>这一栏暂时还是空白，等下一篇文章。 / Nothing here yet.</p>
		</main>
		<Footer />
		<script>
			const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
			const stories = [...document.querySelectorAll<HTMLElement>('.post-list article')];
			const empty = document.querySelector<HTMLElement>('.empty');
			function filterStories(filter = 'all') {
				let visible = 0;
				stories.forEach((story) => {
					const match = filter === 'all' || story.dataset.lang === filter || story.dataset.tags?.split(' ').includes(filter);
					story.hidden = !match;
					if (match) visible++;
				});
				buttons.forEach((button) => button.classList.toggle('active', button.dataset.filter === filter));
				if (empty) empty.hidden = visible > 0;
			}
			buttons.forEach((button) => button.addEventListener('click', () => filterStories(button.dataset.filter)));
			const initial = new URLSearchParams(location.search).get('lang');
			if (initial === 'zh' || initial === 'en') filterStories(initial);
		</script>
	</body>
</html>

<style>
	.archive { width: 100%; max-width: 1280px; padding: 2rem; }
	.head-rule { display: flex; justify-content: space-between; padding: .5rem 0; border-top: 1px solid var(--fg); border-bottom: 3px double var(--fg); font: .6rem var(--font-mono); letter-spacing: .16em; color: var(--fg-muted); }
	.archive-head { display: grid; grid-template-columns: 1.5fr 1fr; align-items: end; gap: 3rem; }
	.archive-head .head-rule { grid-column: 1/-1; }
	.archive-head h1 { margin: 2.5rem 0 3.5rem; font-size: clamp(3.2rem, 7vw, 6rem); line-height: .94; letter-spacing: -.045em; }
	.archive-head p { margin-bottom: 4rem; color: var(--fg-muted); }.archive-head em { font-size: .82rem; }
	.filters { display: flex; gap: .55rem; padding: 1rem 0; border-top: 1px solid var(--border-strong); }
	.filters button { padding: .5rem .7rem; color: var(--fg-muted); background: transparent; border: 1px solid var(--border); font: .58rem var(--font-mono); letter-spacing: .1em; cursor: pointer; }.filters button:hover,.filters .active { color: white; background: var(--accent); border-color: var(--accent); }
	.post-list { border-top: 3px double var(--fg); }
	.empty { padding: 4rem 0; color: var(--fg-muted); text-align: center; }
	article { display: grid; grid-template-columns: 240px 45px 1fr auto; gap: 1.5rem; align-items: center; padding: 1.4rem 0; border-bottom: 1px solid var(--border-strong); }
	.thumb { display: block; aspect-ratio: 16/10; overflow: hidden; background: var(--border); }.thumb :global(img) { width:100%; height:100%; object-fit:cover; filter:saturate(.7); transition: .5s var(--ease); }.thumb:hover :global(img){transform:scale(1.03);filter:saturate(1)}
	.number { color: var(--accent); font: .65rem var(--font-mono); align-self: start; }
	.meta { display:flex; flex-wrap:wrap; gap:1rem; color:var(--fg-muted); font:.58rem var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
	h2 { margin: .35rem 0; font-size: clamp(1.35rem, 2.4vw, 1.95rem); }h2 a { color:inherit;text-decoration:none; }article p{margin:0;color:var(--fg-muted);font-size:.88rem;}
	.arrow{color:var(--accent);font-size:1.35rem;text-decoration:none;}
	@media(max-width:700px){.archive{padding:1.2rem 1.1rem 4rem}.archive-head{grid-template-columns:1fr}.archive-head h1{margin:2rem 0 0;font-size:clamp(2.8rem,14vw,4rem)}.archive-head p{margin:0 0 2rem}.filters{overflow-x:auto}.filters button{white-space:nowrap}article{grid-template-columns:48px 1fr auto;gap:.8rem}.thumb{grid-column:1/-1;aspect-ratio:16/9}.number{grid-column:1}.post-copy{grid-column:2}.arrow{grid-column:3}article p{display:none}}
</style>
