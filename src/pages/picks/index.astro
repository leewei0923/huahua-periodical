---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getEvergreenPosts } from '../../lib/publications';

const posts = getEvergreenPosts(await getCollection('blog'));
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`精选 · ${SITE_TITLE}`} description="不受刊期限制，长期保留的代表文章。" image={posts[0]?.data.heroImage} /></head>
	<body>
		<Header />
		<main class="picks-page">
			<header>
				<div class="rule"><span>EDITOR'S SELECTION</span><span>{String(posts.length).padStart(2, '0')} PICKS</span></div>
				<p class="eyebrow">KEEPERS / 长期精选</p>
				<h1>值得反复<br />翻开的篇章</h1>
				<p class="intro">这里不按日期排列，只保留想长期推荐的内容。本周精选仍然只出现在当周首页和对应刊期中。</p>
			</header>
			{posts.length > 0 ? (
				<section class="pick-grid">
					{posts.map((post, index) => (
						<article>
							<a class="image" href={`/blog/${post.id}/`}>
								{post.data.heroImage && <Image src={post.data.heroImage} alt={post.data.title} widths={[480, 760]} sizes="(max-width: 700px) 100vw, 45vw" />}
								<span>{String(index + 1).padStart(2, '0')}</span>
							</a>
							<div class="meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.type.toUpperCase()}</span></div>
							<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
							<p>{post.data.description}</p>
						</article>
					))}
				</section>
			) : (
				<section class="empty"><h2>精选书架还是空的。</h2><p>在文章 frontmatter 中设置 <code>evergreen: true</code> 后，它会出现在这里。</p><a href="/blog">浏览全部文章 →</a></section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.picks-page { width: 100%; max-width: 1280px; padding: 2rem; }
	.rule { display: flex; justify-content: space-between; padding: .5rem 0; border-top: 1px solid var(--fg); border-bottom: 3px double var(--fg); color: var(--fg-muted); font: .6rem var(--font-mono); letter-spacing: .16em; }
	header { display: grid; grid-template-columns: 1.4fr .8fr; align-items: end; gap: 3rem; padding-bottom: 4rem; }
	header .rule, .eyebrow { grid-column: 1/-1; }.eyebrow { margin: 2.5rem 0 0; color: var(--accent); font: .62rem var(--font-mono); letter-spacing: .18em; }
	h1 { margin: 0; font-size: clamp(3.4rem, 7.5vw, 6.5rem); line-height: .92; letter-spacing: -.05em; }
	.intro { margin: 0; color: var(--fg-muted); }
	.pick-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 5rem 2rem; padding-top: 2rem; border-top: 3px double var(--fg); }
	.image { position: relative; display: block; aspect-ratio: 16/10; overflow: hidden; background: var(--border); }
	.image :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.72); transition: .6s var(--ease); }.image:hover :global(img) { transform: scale(1.025); filter: saturate(1); }
	.image span { position: absolute; top: 1rem; left: 1rem; padding: .35rem .55rem; color: white; background: var(--accent); font: .58rem var(--font-mono); }
	.meta { display: flex; justify-content: space-between; margin-top: .8rem; color: var(--accent); font: .58rem var(--font-mono); letter-spacing: .12em; }
	article h2 { margin-top: .5rem; font-size: clamp(1.6rem, 3vw, 2.3rem); }article h2 a { color: inherit; text-decoration: none; }article p { color: var(--fg-muted); }
	.empty { padding: 5rem 1rem; border-top: 3px double var(--fg); text-align: center; }.empty p { color: var(--fg-muted); }
	@media (max-width: 700px) { .picks-page { padding: 1.2rem 1.1rem 4rem; }header { grid-template-columns: 1fr; gap: 1.5rem; }.pick-grid { grid-template-columns: 1fr; gap: 3rem; } }
</style>
