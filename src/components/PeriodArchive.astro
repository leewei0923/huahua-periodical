---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { formatPeriodRange, kindLabel, type PeriodKind } from '../lib/periods';
import type { PeriodEntry } from '../lib/publications';

interface Props {
	kind: PeriodKind;
	periods: PeriodEntry[];
}

const { kind, periods } = Astro.props;
const label = kindLabel(kind);
const descriptions: Record<PeriodKind, string> = {
	weekly: '每周一册，收录这一周写下的文章、片段与照片。',
	monthly: '按月回看写作轨迹，以及每个月留下的主题。',
	yearly: '一年一本，把十二个月重新装订成册。',
};
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`${label.zh} · ${SITE_TITLE}`} description={descriptions[kind] || SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="period-archive">
			<header>
				<div class="rule"><span>{label.en.toUpperCase()} ARCHIVE</span><span>{String(periods.length).padStart(2, '0')} ISSUES</span></div>
				<p class="eyebrow">PUBLICATION ARCHIVE / 刊物归档</p>
				<h1>{label.zh}</h1>
				<p class="intro">{descriptions[kind]}</p>
				<nav class="period-tabs" aria-label="刊物类型">
					<a class:list={{ active: kind === 'weekly' }} href="/weekly">周刊</a>
					<a class:list={{ active: kind === 'monthly' }} href="/monthly">月刊</a>
					<a class:list={{ active: kind === 'yearly' }} href="/yearly">年刊</a>
				</nav>
			</header>

			{periods.length > 0 ? (
				<section class="issue-list">
					{periods.map((period, index) => (
						<a class="issue-row" href={`/${kind}/${period.id}/`}>
							<span class="number">{String(index + 1).padStart(2, '0')}</span>
							<span class="issue-name"><strong>{period.title}</strong><small>{period.id}</small></span>
							<span class="range">{formatPeriodRange(period)}</span>
							<span class="count">{period.count} 篇</span>
							<span class:list={['status', { closed: period.closed }]}>{period.closed ? '已定稿' : '更新中'}</span>
							<span class="arrow">→</span>
						</a>
					))}
				</section>
			) : (
				<section class="empty"><p>还没有可以装订的{label.zh}。</p><a href="/blog">先去阅读文章 →</a></section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.period-archive { width: 100%; max-width: 1280px; padding: 2rem; }
	.rule { display: flex; justify-content: space-between; padding: .5rem 0; border-top: 1px solid var(--fg); border-bottom: 3px double var(--fg); color: var(--fg-muted); font: .6rem var(--font-mono); letter-spacing: .16em; }
	header { padding-bottom: 3rem; }
	.eyebrow { margin: 3rem 0 .5rem; color: var(--accent); font: .62rem var(--font-mono); letter-spacing: .18em; }
	h1 { margin: 0; font-size: clamp(4rem, 9vw, 7rem); letter-spacing: -.06em; }
	.intro { max-width: 38rem; margin: 1rem 0 2rem; color: var(--fg-muted); font-size: 1rem; }
	.period-tabs { display: flex; gap: .6rem; }
	.period-tabs a { padding: .55rem .9rem; color: var(--fg-muted); border: 1px solid var(--border-strong); font: .62rem var(--font-mono); letter-spacing: .12em; text-decoration: none; }
	.period-tabs a:hover, .period-tabs a.active { color: white; background: var(--accent); border-color: var(--accent); }
	.issue-list { border-top: 3px double var(--fg); }
	.issue-row { display: grid; grid-template-columns: 50px minmax(180px, 1fr) minmax(150px, .7fr) 70px 70px 24px; gap: 1rem; align-items: center; padding: 1.4rem 0; color: var(--fg); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
	.issue-row:hover .issue-name strong, .issue-row:hover .arrow { color: var(--accent); }
	.number, .range, .count, .status { color: var(--fg-muted); font: .58rem var(--font-mono); letter-spacing: .1em; }
	.issue-name { display: flex; flex-direction: column; }
	.issue-name strong { font-size: 1.35rem; transition: color 180ms var(--ease); }
	.issue-name small { color: var(--fg-muted); font: .58rem var(--font-mono); letter-spacing: .12em; }
	.status { width: max-content; padding: .3rem .45rem; border: 1px solid var(--border); }
	.status.closed { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
	.arrow { color: var(--accent); font-size: 1.2rem; }
	.empty { padding: 4rem 0; border-top: 3px double var(--fg); text-align: center; }
	.empty p { color: var(--fg-muted); }
	@media (max-width: 760px) {
		.period-archive { padding: 1.2rem 1.1rem 4rem; }
		.eyebrow { margin-top: 2rem; }
		.issue-row { grid-template-columns: 34px 1fr auto; gap: .7rem; }
		.range, .count, .status { display: none; }
		.arrow { grid-column: 3; }
	}
</style>
