---
interface Moment { time: string; text: string; }
interface Props { items: Moment[]; }
const { items } = Astro.props;
---

<div class="moment-line" aria-label="一天的十二个瞬间">
	{items.map((item, index) => (
		<div class="moment">
			<div class="marker"><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
			<time>{item.time}</time>
			<p>{item.text}</p>
		</div>
	))}
</div>

<style>
	.moment-line { margin: 2.5rem 0 3rem; border-top: 3px double var(--fg); }
	.moment { display: grid; grid-template-columns: 3rem 4.5rem 1fr; gap: 1rem; align-items: baseline; padding: .85rem 0; border-bottom: 1px solid var(--border); }
	.marker { display: flex; align-items: center; gap: .55rem; color: var(--accent); font: .55rem var(--font-mono); }
	.marker i { width: 5px; height: 5px; flex: none; background: var(--accent); border-radius: 50%; }
	time { color: var(--fg); font: 600 .72rem var(--font-mono); }
	p { margin: 0; color: var(--fg-soft); font-size: .92rem; line-height: 1.65; }
	@media (max-width: 520px) { .moment { grid-template-columns: 2.5rem 3.5rem 1fr; gap: .55rem; } }
</style>
