---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import QiniuImage from './QiniuImage.astro';
import { SITE_TITLE } from '../consts';
import { getContentTypeLabel } from '../lib/content';
import { formatPeriodRange, kindLabel, type PeriodInfo, type PeriodKind } from '../lib/periods';
import { getFeaturedPosts, type BlogPost, type IssueSnapshot } from '../lib/publications';

interface Props {
	kind: PeriodKind;
	period: PeriodInfo;
	posts: BlogPost[];
	snapshot?: IssueSnapshot;
}

const { kind, period, posts, snapshot } = Astro.props;
const label = kindLabel(kind);
const [lead] = posts;
const picks = getFeaturedPosts(posts, { exclude: lead ? [lead.id] : [], snapshot });
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`${period.title} · ${SITE_TITLE}`} description={snapshot?.summary ?? `${period.title}，共收录 ${posts.length} 篇内容。`} image={lead?.data.heroImage?.src} /></head>
	<body>
		<Header />
		<main class="issue">
			<header class="issue-head">
				<div class="rule"><a href={`/${kind}`}>← {label.zh}归档</a><span>{snapshot ? 'CLOSED EDITION / 已定稿' : 'LIVE EDITION / 更新中'}</span></div>
				<div class="headline">
					<div><p class="eyebrow">{label.en.toUpperCase()} / {period.id}</p><h1>{period.title}</h1></div>
					<div class="issue-meta"><span>{formatPeriodRange(period)}</span><strong>{String(posts.length).padStart(2, '0')}</strong><small>STORIES</small></div>
				</div>
				<p class="summary">{snapshot?.summary ?? `这一期共收录 ${posts.length} 篇内容。当前刊期会随新文章继续更新，结束后自动定稿。`}</p>
			</header>

			{lead && (
				<section class="lead">
					<a class="lead-image" href={`/blog/${lead.id}/`} style={lead.data.heroImage ? `--lead-bg: url("${lead.data.heroImage.src}")` : undefined}>
						{lead.data.heroImage && (
							<QiniuImage {...lead.data.heroImage} class="lead-art" sizes="(max-width: 800px) 100vw, 62vw" priority />
						)}
						<span>LATEST / 最新发布</span>
					</a>
					<div class="lead-copy">
						<p class="kicker">{getContentTypeLabel(lead.data.contentType, 'en').toUpperCase()} · {lead.data.language.toUpperCase()}</p>
						<h2><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
						<p>{lead.data.description}</p>
						<FormattedDate date={lead.data.pubDate} />
					</div>
				</section>
			)}

			{picks.length > 0 && (
				<section class="picks">
					<div class="section-title"><h2>本期精选</h2><span>EDITOR'S PICKS · {String(picks.length).padStart(2, '0')}</span></div>
					<div class="pick-grid">
						{picks.map((post, index) => (
							<article>
								<span class="pick-no">PICK / {String(index + 1).padStart(2, '0')}</span>
								<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
								<FormattedDate date={post.data.pubDate} />
							</article>
						))}
					</div>
				</section>
			)}

			<section class="contents">
				<div class="section-title"><h2>本期目录</h2><span>COMPLETE CONTENTS</span></div>
				{posts.length > 0 ? (
					<div class="post-list">
						{posts.map((post, index) => (
							<article>
								<span class="post-no">{String(index + 1).padStart(2, '0')}</span>
								<div class="post-copy">
									<div class="meta"><FormattedDate date={post.data.pubDate} /><span>{getContentTypeLabel(post.data.contentType)}</span><span>{post.data.language}</span></div>
									<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
									<p>{post.data.description}</p>
								</div>
								<a class="arrow" href={`/blog/${post.id}/`} aria-label={`阅读 ${post.data.title}`}>→</a>
							</article>
						))}
					</div>
				) : (
					<div class="empty-issue"><p>这一期还没有内容。发布第一篇文章后，目录会自动更新。</p></div>
				)}
			</section>

			<nav class="data-links">
				<a href={`/data/v1/issues/${kind}/${period.id}.json`}>本期 JSON ↗</a>
				<a href="/rss.xml">文章 RSS ↗</a>
				{kind === 'weekly' && <a href="/weekly/rss.xml">周刊 RSS ↗</a>}
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.issue { width: 100%; max-width: 1280px; padding: 2rem; }
	.rule { display: flex; justify-content: space-between; padding: .5rem 0; border-top: 1px solid var(--fg); border-bottom: 3px double var(--fg); color: var(--fg-muted); font: .58rem var(--font-mono); letter-spacing: .14em; }
	.rule a { color: inherit; text-decoration: none; }
	.headline { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: end; padding: 3rem 0 1rem; }
	.eyebrow, .kicker { color: var(--accent); font: .62rem var(--font-mono); letter-spacing: .17em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(3.2rem, 7vw, 6.5rem); letter-spacing: -.05em; }
	.issue-meta { min-width: 150px; display: grid; grid-template-columns: 1fr auto; gap: 0 .7rem; padding-left: 1.2rem; border-left: 1px solid var(--border-strong); color: var(--fg-muted); font: .58rem var(--font-mono); }
	.issue-meta span { grid-column: 1/-1; }.issue-meta strong { color: var(--accent); font-size: 2.2rem; line-height: 1; }.issue-meta small { align-self: end; }
	.summary { max-width: 48rem; margin: 0 0 3rem; color: var(--fg-muted); }
	.lead { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(300px, 1fr); background: var(--fg); color: white; }
	.lead-image { min-height: 580px; position: relative; display: grid; place-items: center; overflow: hidden; isolation: isolate; padding: clamp(2rem, 4vw, 4rem); background: #e8e5de; }
	.lead-image::before { content: ""; position: absolute; z-index: 0; inset: -6rem; background: var(--lead-bg, #e8e5de) center / cover no-repeat; filter: blur(90px) saturate(.42); transform: scale(1.15); opacity: .16; pointer-events: none; }
	.lead-image::after { content: ""; position: absolute; z-index: 1; inset: 0; background: rgba(239,236,228,.28); pointer-events: none; }
	.lead-image :global(.lead-art) { position: relative; z-index: 2; width: auto; height: auto; max-width: 88%; max-height: 580px; object-fit: contain; filter: saturate(.84); box-shadow: 0 18px 42px rgba(0,0,0,.22); }
	.lead-image > span { position: absolute; z-index: 3; top: 1rem; left: 1rem; padding: .35rem .55rem; color: white; background: var(--accent); font: .56rem var(--font-mono); letter-spacing: .12em; }
	.lead-copy { align-self: center; padding: clamp(2rem, 5vw, 4rem); }
	.lead-copy h2 { color: white; font-size: clamp(2rem, 3.4vw, 3rem); }.lead-copy h2 a { color: inherit; text-decoration: none; }
	.lead-copy > p:not(.kicker) { color: #bdb8ae; }.lead-copy :global(time) { color: #8f8c85; font-size: .62rem; }
	.picks, .contents { padding-top: 5rem; }
	.section-title { display: flex; justify-content: space-between; align-items: end; padding-bottom: .8rem; border-bottom: 3px double var(--fg); }
	.section-title h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }.section-title span { color: var(--fg-muted); font: .58rem var(--font-mono); letter-spacing: .14em; }
	.pick-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--border-strong); }
	.pick-grid article { padding: 2rem; border-right: 1px solid var(--border-strong); }.pick-grid article:first-child { padding-left: 0; }.pick-grid article:last-child { border-right: 0; }
	.pick-no, .meta, .post-no { color: var(--accent); font: .58rem var(--font-mono); letter-spacing: .12em; }
	.pick-grid h3 { margin-top: 1rem; font-size: 1.5rem; }.pick-grid h3 a, .post-list h3 a { color: inherit; text-decoration: none; }
	.pick-grid p, .post-list p { color: var(--fg-muted); font-size: .88rem; }.pick-grid :global(time) { color: var(--fg-muted); font-size: .58rem; }
	.post-list { border-bottom: 1px solid var(--border-strong); }
	.empty-issue { padding: 4rem 1rem; color: var(--fg-muted); border-bottom: 1px solid var(--border-strong); text-align: center; }
	.post-list article { display: grid; grid-template-columns: 48px 1fr auto; gap: 1rem; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
	.post-list article:last-child { border-bottom: 0; }
	.meta { display: flex; gap: 1rem; color: var(--fg-muted); text-transform: uppercase; }
	.post-list h3 { margin: .35rem 0; font-size: 1.6rem; }.post-list p { margin: 0; }.arrow { color: var(--accent); font-size: 1.3rem; text-decoration: none; }
	.data-links { display: flex; gap: 1rem; flex-wrap: wrap; padding: 2rem 0 5rem; }
	.data-links a { padding: .65rem .8rem; color: var(--fg); border: 1px solid var(--border-strong); font: .58rem var(--font-mono); letter-spacing: .1em; text-decoration: none; }
	.data-links a:hover { color: white; background: var(--accent); border-color: var(--accent); }
	@media (max-width: 760px) {
		.issue { padding: 1.2rem 1.1rem 3rem; }
		.headline { grid-template-columns: 1fr; padding-top: 2rem; }.issue-meta { display: none; }
		.lead { grid-template-columns: 1fr; }.lead-image { min-height: 0; padding: 2.5rem 1.5rem; }.lead-image :global(.lead-art) { max-width: 86%; max-height: min(64vh, 580px); }.lead-copy { padding: 2rem 1.3rem 2.5rem; }
		.pick-grid { grid-template-columns: 1fr; }.pick-grid article, .pick-grid article:first-child { padding: 1.5rem 0; border-right: 0; border-bottom: 1px solid var(--border); }.pick-grid article:last-child { border-bottom: 0; }
		.post-list article { grid-template-columns: 32px 1fr auto; }.post-list p { display: none; }
		.section-title span { display: none; }
	}
</style>
