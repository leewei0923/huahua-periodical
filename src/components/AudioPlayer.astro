---
interface Props {
  src: string;
  subtitle?: string;
  title?: string;
}

const { src, subtitle, title } = Astro.props;
---

{/* SVG 溶解滤镜 - 全局定义 */}
<svg style="position: absolute; width: 0; height: 0;" aria-hidden="true">
  <defs>
    <filter id="dissolve-filter" x="-200%" y="-200%" width="500%" height="500%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.002" numOctaves="1" result="big" />
      <feComponentTransfer in="big" result="bigAdj">
        <feFuncR type="linear" slope="5" intercept="-2" />
        <feFuncG type="linear" slope="5" intercept="-2" />
      </feComponentTransfer>
      <feTurbulence type="fractalNoise" baseFrequency="1" numOctaves="1" result="fine" />
      <feMerge result="noise">
        <feMergeNode in="bigAdj" />
        <feMergeNode in="fine" />
      </feMerge>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>

<div class="audio-mode-container" data-src={src} data-subtitle={subtitle}>
  {/* 模式切换 */}
  <div class="mode-switch">
    <div class="mode-switch-left">
      <button class="mode-btn active" data-mode="audio">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        语音模式
      </button>
      <button class="mode-btn" data-mode="text">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7V4h16v3"></path>
          <path d="M9 20h6"></path>
          <path d="M12 4v16"></path>
        </svg>
        纯文本
      </button>
    </div>
    <div class="mode-switch-right">
      <button class="fullscreen-btn" aria-label="全屏专注" title="全屏专注模式">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* 内容区域 - 带溶解滤镜 */}
  <div class="content-wrapper">
    {/* 播放器区域 - 语音模式 */}
    <div class="audio-panel">
      {/* 播放控制栏 */}
      <div class="player-controls">
        <button class="play-btn" aria-label="播放">
          <svg class="play-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <svg class="pause-icon hidden" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>
          </svg>
        </button>
        
        <div class="progress-container">
          <div class="progress-bar">
            <div class="progress-fill"></div>
            <div class="progress-handle"></div>
          </div>
        </div>
        
        <span class="time-display">
          <span class="current-time">00:00</span>
          <span class="separator">/</span>
          <span class="duration">00:00</span>
        </span>
        
        <button class="speed-btn" aria-label="播放速度">1x</button>
      </div>

      {/* 字幕显示区域 */}
      <div class="subtitle-area">
        <div class="subtitle-content">
          <div class="subtitle-prev"></div>
          <div class="subtitle-current"></div>
          <div class="subtitle-next"></div>
        </div>
      </div>
    </div>

    {/* 纯文本区域 */}
    <div class="text-panel hidden">
      <div class="text-content-wrapper">
        <div class="text-content"></div>
      </div>
    </div>
  </div>

  {/* 全屏退出提示 */}
  <div class="fullscreen-hint hidden">
    <span>按 ESC 退出全屏专注</span>
  </div>
</div>

<style>
  .audio-mode-container {
    margin: 2rem 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-soft);
    transition: all 400ms var(--ease);
  }

  /* 溶解滤镜动画 */
  .content-wrapper {
    position: relative;
    filter: url(#dissolve-filter);
  }

  .content-wrapper.dissolving {
    animation: dissolve-in 1000ms ease-out forwards;
  }

  @keyframes dissolve-in {
    0% {
      filter: url(#dissolve-filter);
    }
    100% {
      filter: url(#dissolve-filter);
    }
  }

  /* 全屏模式 */
  .audio-mode-container.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    margin: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  .audio-mode-container.is-fullscreen .mode-switch {
    border-radius: 0;
  }

  .audio-mode-container.is-fullscreen .audio-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .audio-mode-container.is-fullscreen .subtitle-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
  }

  .audio-mode-container.is-fullscreen .subtitle-current {
    font-size: 2rem;
    line-height: 1.8;
  }

  .audio-mode-container.is-fullscreen .subtitle-prev,
  .audio-mode-container.is-fullscreen .subtitle-next {
    font-size: 1.1rem;
  }

  .audio-mode-container.is-fullscreen .fullscreen-hint {
    display: flex;
  }

  .fullscreen-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: var(--fg);
    color: var(--bg);
    border-radius: 20px;
    font: 0.75rem var(--font-mono);
    opacity: 0.6;
    pointer-events: none;
  }

  /* 模式切换 */
  .mode-switch {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .mode-switch-left {
    display: flex;
    flex: 1;
  }

  .mode-switch-right {
    display: flex;
    padding-right: 0.5rem;
  }

  .mode-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: none;
    background: none;
    color: var(--fg-muted);
    font: 0.75rem var(--font-mono);
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 180ms var(--ease);
    position: relative;
  }

  .mode-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 180ms var(--ease);
  }

  .mode-btn.active {
    color: var(--accent);
  }

  .mode-btn.active::after {
    transform: scaleX(1);
  }

  .mode-btn:hover:not(.active) {
    color: var(--fg);
    background: var(--bg-soft);
  }

  .fullscreen-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 8px;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: all 180ms var(--ease);
  }

  .fullscreen-btn:hover {
    color: var(--fg);
    background: var(--bg-soft);
  }

  .fullscreen-btn.is-active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* 播放控制栏 */
  .player-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--fg);
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition: all 180ms var(--ease);
    flex-shrink: 0;
  }

  .play-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .play-btn svg {
    width: 20px;
    height: 20px;
  }

  .hidden {
    display: none !important;
  }

  /* 进度条 */
  .progress-container {
    flex: 1;
    padding: 0.5rem 0;
  }

  .progress-bar {
    position: relative;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    cursor: pointer;
  }

  .progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    width: 0%;
    transition: width 100ms linear;
  }

  .progress-handle {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 180ms var(--ease);
  }

  .progress-bar:hover .progress-handle {
    opacity: 1;
  }

  /* 时间显示 */
  .time-display {
    font: 0.75rem var(--font-mono);
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .separator {
    margin: 0 0.25rem;
    opacity: 0.5;
  }

  /* 速度按钮 */
  .speed-btn {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: none;
    color: var(--fg-muted);
    font: 0.7rem var(--font-mono);
    cursor: pointer;
    transition: all 180ms var(--ease);
  }

  .speed-btn:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  /* 字幕区域 */
  .subtitle-area {
    padding: 2rem 1.5rem;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .subtitle-content {
    width: 100%;
    max-width: 600px;
    text-align: center;
  }

  .subtitle-prev,
  .subtitle-next {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--fg-muted);
    opacity: 0.4;
    padding: 0.5rem 0;
    transition: all 300ms var(--ease);
    cursor: pointer;
  }

  .subtitle-prev:hover,
  .subtitle-next:hover {
    opacity: 0.7;
  }

  .subtitle-current {
    font-size: 1.3rem;
    line-height: 1.8;
    color: var(--fg);
    padding: 1rem 0;
    position: relative;
    min-height: 3rem;
    transition: font-size 300ms var(--ease);
  }

  /* 打字机动画 */
  .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 1.2em;
    background: var(--accent);
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: blink 0.8s infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* 纯文本面板 */
  .text-panel {
    padding: 2rem 1.5rem;
  }

  .text-content-wrapper {
    max-width: 600px;
    margin: 0 auto;
    filter: url(#dissolve-filter);
    transition: filter 300ms var(--ease);
  }

  .text-content-wrapper.dissolving {
    animation: text-dissolve 1000ms ease-out forwards;
  }

  @keyframes text-dissolve {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      opacity: 1;
    }
  }

  .text-content {
    font-size: 1rem;
    line-height: 2;
    color: var(--fg);
  }

  .text-content p {
    margin: 0;
    padding: 0.25rem 0;
    cursor: pointer;
    transition: all 180ms var(--ease);
  }

  .text-content .text-line {
    opacity: 0.6;
  }

  .text-content .text-line:hover {
    opacity: 0.8;
  }

  .text-content .text-line.active {
    opacity: 1;
    color: var(--accent);
  }

  /* 暗色模式适配 */
  :global([data-theme="dark"]) .play-btn {
    border-color: var(--fg);
    color: var(--fg);
  }

  :global([data-theme="dark"]) .play-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .player-controls {
      padding: 0.75rem 1rem;
      gap: 0.75rem;
    }

    .play-btn {
      width: 40px;
      height: 40px;
    }

    .subtitle-area {
      padding: 1.5rem 1rem;
    }

    .subtitle-current {
      font-size: 1.1rem;
    }

    .text-panel {
      padding: 1.5rem 1rem;
    }

    .audio-mode-container.is-fullscreen .subtitle-current {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  function parseTime(timeStr) {
    const [hours, minutes, seconds] = timeStr.split(':');
    const [secs, ms] = seconds.split(',');
    return (
      parseInt(hours, 10) * 3600 +
      parseInt(minutes, 10) * 60 +
      parseInt(secs, 10) +
      parseInt(ms, 10) / 1000
    );
  }

  function parseSrt(content) {
    const entries = [];
    const blocks = content.trim().split(/\n\s*\n/);
    
    for (const block of blocks) {
      const lines = block.trim().split('\n');
      if (lines.length < 3) continue;
      
      const index = parseInt(lines[0], 10);
      const timeMatch = lines[1].match(
        /(\d{2}:\d{2}:\d{2},\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2},\d{3})/
      );
      
      if (!timeMatch) continue;
      
      const startTime = parseTime(timeMatch[1]);
      const endTime = parseTime(timeMatch[2]);
      const text = lines.slice(2).join('\n').trim();
      
      entries.push({ index, startTime, endTime, text });
    }
    
    return entries;
  }

  function formatTime(seconds) {
    if (!seconds || isNaN(seconds)) return '00:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function getCurrentSubtitleIndex(entries, currentTime) {
    for (let i = entries.length - 1; i >= 0; i--) {
      if (currentTime >= entries[i].startTime) {
        return i;
      }
    }
    return -1;
  }

  class AudioModeController {
    constructor(container) {
      this.container = container;
      this.audio = new Audio();
      this.subtitles = [];
      this.currentSubtitleIndex = -1;
      this.isPlaying = false;
      this.playbackRate = 1;
      this.isAudioMode = true;
      this.isFullscreen = false;
      this.typingTimeout = null;
      this.dissolveScale = 0;
      this.isDissolving = false;
      this.init();
    }

    async init() {
      const src = this.container.dataset.src;
      const subtitleUrl = this.container.dataset.subtitle;

      if (src) {
        this.audio.src = src;
        this.audio.preload = 'metadata';
        this.audio.addEventListener('loadedmetadata', () => this.updateDuration());
        this.audio.addEventListener('timeupdate', () => this.onTimeUpdate());
        this.audio.addEventListener('ended', () => this.onEnded());
        this.audio.addEventListener('error', (e) => {
          console.error('Audio load error:', e);
        });
      }

      if (subtitleUrl) {
        try {
          const response = await fetch(subtitleUrl);
          const text = await response.text();
          this.subtitles = parseSrt(text);
          this.renderTextContent();
        } catch (e) {
          console.error('Failed to load subtitle:', e);
        }
      }

      this.initDissolveFilter();
      this.bindEvents();
    }

    initDissolveFilter() {
      // 获取溶解滤镜中的 feDisplacementMap 元素
      this.dissolveMap = document.querySelector('#dissolve-filter feDisplacementMap');
    }

    bindEvents() {
      const playBtn = this.container.querySelector('.play-btn');
      if (playBtn) {
        playBtn.addEventListener('click', () => this.togglePlay());
      }

      const progressBar = this.container.querySelector('.progress-bar');
      if (progressBar) {
        progressBar.addEventListener('click', (e) => {
          const rect = progressBar.getBoundingClientRect();
          const percent = (e.clientX - rect.left) / rect.width;
          if (this.audio.duration) {
            this.audio.currentTime = percent * this.audio.duration;
          }
        });
      }

      const speedBtn = this.container.querySelector('.speed-btn');
      if (speedBtn) {
        speedBtn.addEventListener('click', () => this.toggleSpeed());
      }

      const modeBtns = this.container.querySelectorAll('.mode-btn');
      modeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode;
          this.switchMode(mode === 'audio');
        });
      });

      const fullscreenBtn = this.container.querySelector('.fullscreen-btn');
      if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', () => this.toggleFullscreen());
      }

      const subtitleArea = this.container.querySelector('.subtitle-area');
      if (subtitleArea) {
        subtitleArea.addEventListener('click', (e) => {
          const target = e.target;
          if (target.classList.contains('subtitle-prev') || 
              target.classList.contains('subtitle-next')) {
            const index = parseInt(target.dataset.index || '-1');
            if (index >= 0 && index < this.subtitles.length) {
              this.audio.currentTime = this.subtitles[index].startTime;
            }
          }
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isFullscreen) {
          this.toggleFullscreen();
        }
      });
    }

    // 溶解动画
    playDissolveAnimation(callback) {
      if (this.isDissolving || !this.dissolveMap) {
        if (callback) callback();
        return;
      }

      this.isDissolving = true;
      const duration = 1000; // 1000ms
      const startTime = performance.now();
      const startScale = 0;
      const endScale = 2000;

      const animate = (currentTime) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // 使用 easeOut 缓动函数
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const currentScale = startScale + (endScale - startScale) * easeOut;
        
        this.dissolveMap.setAttribute('scale', currentScale.toString());

        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          // 动画完成，重置
          setTimeout(() => {
            this.dissolveMap.setAttribute('scale', '0');
            this.isDissolving = false;
            if (callback) callback();
          }, 100);
        }
      };

      requestAnimationFrame(animate);
    }

    togglePlay() {
      if (this.isPlaying) {
        this.audio.pause();
      } else {
        this.audio.play().catch(e => console.error('Play failed:', e));
      }
      this.isPlaying = !this.isPlaying;
      this.updatePlayButton();
    }

    toggleSpeed() {
      const speeds = [0.75, 1, 1.25, 1.5, 2];
      const currentIndex = speeds.indexOf(this.playbackRate);
      this.playbackRate = speeds[(currentIndex + 1) % speeds.length];
      this.audio.playbackRate = this.playbackRate;
      const speedBtn = this.container.querySelector('.speed-btn');
      if (speedBtn) {
        speedBtn.textContent = `${this.playbackRate}x`;
      }
    }

    switchMode(isAudio) {
      if (this.isDissolving) return;
      
      this.isAudioMode = isAudio;
      const audioPanel = this.container.querySelector('.audio-panel');
      const textPanel = this.container.querySelector('.text-panel');
      const textContentWrapper = this.container.querySelector('.text-content-wrapper');
      const modeBtns = this.container.querySelectorAll('.mode-btn');

      // 播放溶解动画
      this.playDissolveAnimation(() => {
        if (isAudio) {
          audioPanel.classList.remove('hidden');
          textPanel.classList.add('hidden');
        } else {
          audioPanel.classList.add('hidden');
          textPanel.classList.remove('hidden');
          if (this.isPlaying) {
            this.togglePlay();
          }
          
          // 文字内容溶解效果
          if (textContentWrapper) {
            textContentWrapper.classList.add('dissolving');
            setTimeout(() => {
              textContentWrapper.classList.remove('dissolving');
            }, 1000);
          }
        }
      });

      modeBtns.forEach(btn => {
        const btnMode = btn.dataset.mode;
        btn.classList.toggle('active', btnMode === (isAudio ? 'audio' : 'text'));
      });
    }

    toggleFullscreen() {
      this.isFullscreen = !this.isFullscreen;
      const fullscreenBtn = this.container.querySelector('.fullscreen-btn');
      
      if (this.isFullscreen) {
        this.container.classList.add('is-fullscreen');
        fullscreenBtn.classList.add('is-active');
        document.body.style.overflow = 'hidden';
        
        if (!this.isPlaying) {
          this.togglePlay();
        }
      } else {
        this.container.classList.remove('is-fullscreen');
        fullscreenBtn.classList.remove('is-active');
        document.body.style.overflow = '';
      }
    }

    updatePlayButton() {
      const playIcon = this.container.querySelector('.play-icon');
      const pauseIcon = this.container.querySelector('.pause-icon');
      if (this.isPlaying) {
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      } else {
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }
    }

    updateDuration() {
      const durationEl = this.container.querySelector('.duration');
      if (durationEl && this.audio.duration) {
        durationEl.textContent = formatTime(this.audio.duration);
      }
    }

    onTimeUpdate() {
      const currentTime = this.audio.currentTime;
      const duration = this.audio.duration;

      if (!duration) return;

      const progressFill = this.container.querySelector('.progress-fill');
      const progressHandle = this.container.querySelector('.progress-handle');
      const percent = (currentTime / duration) * 100;
      if (progressFill) progressFill.style.width = `${percent}%`;
      if (progressHandle) progressHandle.style.left = `${percent}%`;

      const currentTimeEl = this.container.querySelector('.current-time');
      if (currentTimeEl) {
        currentTimeEl.textContent = formatTime(currentTime);
      }

      const newIndex = getCurrentSubtitleIndex(this.subtitles, currentTime);
      if (newIndex !== this.currentSubtitleIndex) {
        this.currentSubtitleIndex = newIndex;
        this.updateSubtitleDisplay();
        this.updateTextHighlight();
      }
    }

    updateSubtitleDisplay() {
      const prevEl = this.container.querySelector('.subtitle-prev');
      const currentEl = this.container.querySelector('.subtitle-current');
      const nextEl = this.container.querySelector('.subtitle-next');

      const index = this.currentSubtitleIndex;

      if (prevEl) {
        const prevIndex = index - 1;
        prevEl.textContent = prevIndex >= 0 ? this.subtitles[prevIndex].text : '';
        prevEl.dataset.index = String(prevIndex);
      }

      if (currentEl) {
        if (index >= 0 && index < this.subtitles.length) {
          this.typewriterEffect(currentEl, this.subtitles[index].text);
        } else {
          currentEl.textContent = '';
        }
      }

      if (nextEl) {
        const nextIndex = index + 1;
        nextEl.textContent = nextIndex < this.subtitles.length ? this.subtitles[nextIndex].text : '';
        nextEl.dataset.index = String(nextIndex);
      }
    }

    typewriterEffect(element, text) {
      if (this.typingTimeout) {
        clearTimeout(this.typingTimeout);
      }

      element.textContent = '';
      let i = 0;
      const cursor = document.createElement('span');
      cursor.className = 'typing-cursor';
      element.appendChild(cursor);

      const type = () => {
        if (i < text.length) {
          const char = document.createTextNode(text[i]);
          element.insertBefore(char, cursor);
          i++;
          const delay = text[i - 1] === '，' || text[i - 1] === '。' ? 200 : 50;
          this.typingTimeout = setTimeout(type, delay);
        } else {
          setTimeout(() => {
            if (cursor.parentNode) {
              cursor.remove();
            }
          }, 1000);
        }
      };

      type();
    }

    renderTextContent() {
      const textContent = this.container.querySelector('.text-content');
      if (!textContent) return;

      textContent.innerHTML = this.subtitles
        .map((sub, i) => `<p class="text-line" data-index="${i}">${sub.text}</p>`)
        .join('');

      textContent.addEventListener('click', (e) => {
        const target = e.target;
        if (target.classList.contains('text-line')) {
          const index = parseInt(target.dataset.index || '0');
          this.audio.currentTime = this.subtitles[index].startTime;
          this.switchMode(true);
          if (!this.isPlaying) this.togglePlay();
        }
      });
    }

    updateTextHighlight() {
      const lines = this.container.querySelectorAll('.text-line');
      lines.forEach((line, i) => {
        line.classList.toggle('active', i === this.currentSubtitleIndex);
      });

      const activeLine = this.container.querySelector('.text-line.active');
      if (activeLine) {
        activeLine.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    onEnded() {
      this.isPlaying = false;
      this.updatePlayButton();
      this.currentSubtitleIndex = -1;
    }
  }

  function initAudioPlayers() {
    const containers = document.querySelectorAll('.audio-mode-container');
    containers.forEach(container => {
      if (!container.dataset.initialized) {
        container.dataset.initialized = 'true';
        new AudioModeController(container);
      }
    });
  }

  document.addEventListener('astro:page-load', initAudioPlayers);
  document.addEventListener('DOMContentLoaded', initAudioPlayers);
</script>
