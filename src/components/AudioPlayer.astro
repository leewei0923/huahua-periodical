---
interface Props {
  src: string;
  subtitle?: string;
  title?: string;
}

const { src, subtitle, title } = Astro.props;
---

<div class="audio-mode-container" data-src={src} data-subtitle={subtitle} data-title={title}>
  <div class="audio-module-head">
    <span>LISTENING TRANSCRIPT / 听稿</span>
    <small>{title || 'VOICE NOTE'}</small>
  </div>

<div class="audio-panel">
    {/* 播放控制栏 */}
    <div class="player-controls">
      <button class="play-btn" aria-label="播放">
        <svg class="play-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg class="pause-icon hidden" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>
        </svg>
      </button>
      
      <div class="progress-container">
        <div class="progress-bar">
          <div class="progress-fill"></div>
          <div class="progress-handle"></div>
        </div>
      </div>
      
      <span class="time-display">
        <span class="current-time">00:00</span>
        <span class="separator">/</span>
        <span class="duration">00:00</span>
      </span>
      
      <button class="speed-btn" aria-label="播放速度">1x</button>
    
      <button class="fullscreen-btn" aria-label="全屏专注" title="全屏专注模式">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
      </button>
    </div>

        <aside class="transcript-rail" aria-label="完整聊听">
      <div class="rail-head">
        <span>FULL TRANSCRIPT</span>
        <small>点击句子跳转 · 跟随高亮</small>
      </div>
      <div class="text-content transcript-content"></div>
    </aside>
  </div>



  {/* 全屏退出提示 */}
  <div class="fullscreen-hint hidden">
    <span>按 ESC 退出全屏专注</span>
  </div>
</div>

<style>
  .audio-mode-container {
    margin: 2.75rem 0;
    border-top: 3px double var(--fg);
    border-bottom: 1px solid var(--border-strong);
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-soft) 72%, var(--bg));
    transition: background-color 240ms var(--ease), border-color 240ms var(--ease);
  }

  .audio-module-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 0;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--border);
    font: 0.72rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .audio-module-head span {
    color: var(--accent);
  }

  .audio-module-head small {
    overflow: hidden;
    color: var(--fg-muted);
    font: inherit;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 全屏模式 */
  .audio-mode-container.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    margin: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  .audio-mode-container.is-fullscreen .audio-module-head {
    padding: 1rem 1.25rem;
  }

  .audio-mode-container.is-fullscreen .audio-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .audio-mode-container.is-fullscreen .player-controls {
    padding: 1rem 1.25rem;
  }

  .audio-mode-container.is-fullscreen .transcript-rail {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.4rem, 3vw, 2.4rem);
    background: color-mix(in srgb, var(--bg-soft) 58%, var(--bg));
  }

  .audio-mode-container.is-fullscreen .transcript-content {
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 2.2;
  }

  .audio-mode-container.is-fullscreen :global(.text-line) {
    padding: 0.7rem 1rem 0.7rem 1.2rem;
  }

  .audio-mode-container.is-fullscreen .fullscreen-hint {
    display: flex;
  }

  .fullscreen-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: var(--fg);
    color: var(--bg);
    border-radius: 0;
    font: 0.82rem var(--font-mono);
    opacity: 0.6;
    pointer-events: none;
  }

  .fullscreen-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 0;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: all 180ms var(--ease);
  }

  .fullscreen-btn:hover {
    color: var(--fg);
    background: var(--bg-soft);
  }

  .fullscreen-btn.is-active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* 播放控制栏 */
  .player-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    background: transparent;
    border-bottom: 1px solid var(--border);
  }

  .play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 2px solid var(--fg);
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition: all 180ms var(--ease);
    flex-shrink: 0;
  }

  .play-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .play-btn svg {
    width: 20px;
    height: 20px;
  }

  .hidden {
    display: none !important;
  }

  /* 进度条 */
  .progress-container {
    flex: 1;
    padding: 0.5rem 0;
  }

  .progress-bar {
    position: relative;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    cursor: pointer;
  }

  .progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    width: 0%;
    transition: width 100ms linear;
  }

  .progress-handle {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 180ms var(--ease);
  }

  .progress-bar:hover .progress-handle {
    opacity: 1;
  }

  .progress-bar:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .progress-bar:focus-visible .progress-handle {
    opacity: 1;
  }

  /* 时间显示 */
  .time-display {
    font: 0.82rem var(--font-mono);
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .separator {
    margin: 0 0.25rem;
    opacity: 0.5;
  }

  /* 速度按钮 */
  .speed-btn {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: none;
    color: var(--fg-muted);
    font: 0.8rem var(--font-mono);
    cursor: pointer;
    transition: all 180ms var(--ease);
  }

  .speed-btn:hover {
    border-color: var(--fg);
    color: var(--fg);
  }


  .transcript-rail {
    display: flex;
    flex-direction: column;
    max-height: 55vh;
    min-height: 0;
    padding: 1.4rem clamp(1rem, 3vw, 1.5rem);
    border-top: 1px solid var(--border);
  }


  .rail-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 3px double var(--fg);
    color: var(--fg-muted);
    font: 0.72rem var(--font-mono);
    letter-spacing: 0.1em;
  }

  .rail-head span {
    color: var(--accent);
  }

  .transcript-content {
    flex: 1;
    min-height: 0;
    max-width: none;
    margin: 1.2rem 0 0;
    padding-right: 0.5rem;
    overflow: auto;
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .transcript-content :global(.text-line) {
    padding: 0.55rem 0.85rem 0.55rem 1rem;
    border-left: 2px solid transparent;
    cursor: pointer;
    opacity: 0.65;
    transition: color 180ms var(--ease), background-color 180ms var(--ease), opacity 180ms var(--ease);
  }

  .transcript-content :global(.text-line:hover) {
    opacity: 0.9;
  }

  .transcript-content :global(.text-line.active) {
    opacity: 1;
    color: var(--fg);
    background: var(--accent-soft);
    border-left-color: var(--accent);
  }


  /* 暗色模式适配 */
  :global([data-theme="dark"]) .audio-mode-container {
    background: color-mix(in srgb, var(--surface) 72%, var(--bg));
    border-top-color: #c4c4c4;
    border-bottom-color: var(--border-strong);
  }

  :global([data-theme="dark"]) .audio-module-head,
  :global([data-theme="dark"]) .player-controls,
  :global([data-theme="dark"]) .transcript-rail {
    border-color: var(--border-subtle);
  }

  :global([data-theme="dark"]) .audio-mode-container.is-fullscreen .transcript-rail {
    background: color-mix(in srgb, var(--surface) 58%, var(--bg));
  }

  :global([data-theme="dark"]) .rail-head {
    border-color: #c4c4c4;
  }

  :global([data-theme="dark"]) .play-btn {
    border-color: var(--fg);
    color: var(--fg);
  }

  :global([data-theme="dark"]) .play-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .player-controls {
      padding: 0.75rem 1rem;
      gap: 0.75rem;
    }

    .play-btn {
      width: 40px;
      height: 40px;
    }

    .transcript-rail {
      padding: 1rem;
    }

    .fullscreen-btn {
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 900px) {
    .audio-mode-container.is-fullscreen .transcript-content {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  function parseTime(timeStr) {
    const [hours, minutes, seconds] = timeStr.split(':');
    const [secs, ms] = seconds.split(',');
    return (
      parseInt(hours, 10) * 3600 +
      parseInt(minutes, 10) * 60 +
      parseInt(secs, 10) +
      parseInt(ms, 10) / 1000
    );
  }

  function parseSrt(content) {
    const entries = [];
    const blocks = content.trim().split(/\n\s*\n/);
    
    for (const block of blocks) {
      const lines = block.trim().split('\n');
      if (lines.length < 3) continue;
      
      const index = parseInt(lines[0], 10);
      const timeMatch = lines[1].match(
        /(\d{2}:\d{2}:\d{2},\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2},\d{3})/
      );
      
      if (!timeMatch) continue;
      
      const startTime = parseTime(timeMatch[1]);
      const endTime = parseTime(timeMatch[2]);
      const text = lines.slice(2).join('\n').trim();
      
      entries.push({ index, startTime, endTime, text });
    }
    
    return entries;
  }

  function formatTime(seconds) {
    if (!seconds || isNaN(seconds)) return '00:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function getCurrentSubtitleIndex(entries, currentTime) {
    for (let i = entries.length - 1; i >= 0; i--) {
      if (currentTime >= entries[i].startTime) {
        return i;
      }
    }
    return -1;
  }

  class AudioModeController {
    constructor(container) {
      this.container = container;
      this.audio = new Audio();
      this.subtitles = [];
      this.currentSubtitleIndex = -1;
      this.isPlaying = false;
      this.playbackRate = 1;
      this.isFullscreen = false;
      this.init();
    }

    async init() {
      const src = this.container.dataset.src;
      const subtitleUrl = this.container.dataset.subtitle;

      if (src) {
        this.audio.src = src;
        this.audio.preload = 'metadata';
        this.audio.addEventListener('loadedmetadata', () => this.updateDuration());
        this.audio.addEventListener('timeupdate', () => this.onTimeUpdate());
        this.audio.addEventListener('ended', () => this.onEnded());
        this.audio.addEventListener('error', (e) => {
          console.error('Audio load error:', e);
        });
      }

      if (subtitleUrl) {
        try {
          const response = await fetch(subtitleUrl);
          const text = await response.text();
          this.subtitles = parseSrt(text);
          this.renderTextContent();
        } catch (e) {
          console.error('Failed to load subtitle:', e);
        }
      }

      this.bindEvents();
    }

    bindEvents() {
      const playBtn = this.container.querySelector('.play-btn');
      if (playBtn) {
        playBtn.addEventListener('click', () => this.togglePlay());
      }

      const progressBar = this.container.querySelector('.progress-bar');
      if (progressBar) {
        progressBar.addEventListener('click', (e) => {
          const rect = progressBar.getBoundingClientRect();
          const percent = (e.clientX - rect.left) / rect.width;
          if (this.audio.duration) {
            this.audio.currentTime = percent * this.audio.duration;
          }
        });
        progressBar.setAttribute('role', 'slider');
        progressBar.setAttribute('tabindex', '0');
        progressBar.setAttribute('aria-label', '播放进度');
        progressBar.setAttribute('aria-valuemin', '0');
        progressBar.setAttribute('aria-valuemax', '100');
        progressBar.setAttribute('aria-valuenow', '0');
        progressBar.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const delta = e.key === 'ArrowRight' ? 5 : -5;
            const duration = this.audio.duration || 0;
            this.audio.currentTime = Math.min(duration, Math.max(0, this.audio.currentTime + delta));
          } else if (e.key === 'Home') {
            e.preventDefault();
            this.audio.currentTime = 0;
          } else if (e.key === 'End') {
            e.preventDefault();
            this.audio.currentTime = this.audio.duration || 0;
          }
        });
      }

      const speedBtn = this.container.querySelector('.speed-btn');
      if (speedBtn) {
        speedBtn.addEventListener('click', () => this.toggleSpeed());
      }


      const fullscreenBtn = this.container.querySelector('.fullscreen-btn');
      if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', () => this.toggleFullscreen());
      }

    }

    togglePlay() {
      if (this.isPlaying) {
        this.audio.pause();
      } else {
        this.audio.play().catch(e => console.error('Play failed:', e));
      }
      this.isPlaying = !this.isPlaying;
      this.updatePlayButton();
    }

    toggleSpeed() {
      const speeds = [0.75, 1, 1.25, 1.5, 2];
      const currentIndex = speeds.indexOf(this.playbackRate);
      this.playbackRate = speeds[(currentIndex + 1) % speeds.length];
      this.audio.playbackRate = this.playbackRate;
      const speedBtn = this.container.querySelector('.speed-btn');
      if (speedBtn) {
        speedBtn.textContent = `${this.playbackRate}x`;
      }
    }


    toggleFullscreen() {
      this.isFullscreen = !this.isFullscreen;
      const fullscreenBtn = this.container.querySelector('.fullscreen-btn');
      
      if (this.isFullscreen) {
        this.container.classList.add('is-fullscreen');
        fullscreenBtn.classList.add('is-active');
        document.body.style.overflow = 'hidden';
        setTimeout(() => this.updateTextHighlight(), 0);
        
        if (!this.isPlaying) {
          this.togglePlay();
        }
      } else {
        this.container.classList.remove('is-fullscreen');
        fullscreenBtn.classList.remove('is-active');
        document.body.style.overflow = '';
      }
    }

    updatePlayButton() {
      const playIcon = this.container.querySelector('.play-icon');
      const pauseIcon = this.container.querySelector('.pause-icon');
      if (this.isPlaying) {
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      } else {
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }
    }

    updateDuration() {
      const durationEl = this.container.querySelector('.duration');
      if (durationEl && this.audio.duration) {
        durationEl.textContent = formatTime(this.audio.duration);
      }
    }

    onTimeUpdate() {
      const currentTime = this.audio.currentTime;
      const duration = this.audio.duration;

      if (!duration) return;

      const progressFill = this.container.querySelector('.progress-fill');
      const progressHandle = this.container.querySelector('.progress-handle');
      const progressBar = this.container.querySelector('.progress-bar');
      const percent = (currentTime / duration) * 100;
      if (progressBar) progressBar.setAttribute('aria-valuenow', String(Math.round(percent)));
      if (progressFill) progressFill.style.width = `${percent}%`;
      if (progressHandle) progressHandle.style.left = `${percent}%`;

      const currentTimeEl = this.container.querySelector('.current-time');
      if (currentTimeEl) {
        currentTimeEl.textContent = formatTime(currentTime);
      }

      const newIndex = getCurrentSubtitleIndex(this.subtitles, currentTime);
      if (newIndex !== this.currentSubtitleIndex) {
        this.currentSubtitleIndex = newIndex;
        this.updateTextHighlight();
      }
    }



    renderTextContent() {
      const transcript = this.container.querySelector('.transcript-content');
      if (!transcript) return;

      const markup = this.subtitles
        .map((sub, i) => `<p class="text-line" data-index="${i}">${sub.text}</p>`)
        .join('');
      transcript.innerHTML = markup;
      transcript.addEventListener('click', (e) => {
        const target = e.target;
        if (target.classList.contains('text-line')) {
          const index = parseInt(target.dataset.index || '0');
          this.audio.currentTime = this.subtitles[index].startTime;
          if (!this.isPlaying) this.togglePlay();
        }
      });
    }

    updateTextHighlight() {
      const lines = this.container.querySelectorAll('.text-line');
      lines.forEach((line, i) => {
        line.classList.toggle('active', i === this.currentSubtitleIndex);
      });

      const activeLine = this.container.querySelector('.text-line.active');
      const rail = this.container.querySelector('.transcript-content');
      if (activeLine && rail) {
        const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        const lineRect = activeLine.getBoundingClientRect();
        const railRect = rail.getBoundingClientRect();
        const target = rail.scrollTop + (lineRect.top - railRect.top) - (railRect.height - lineRect.height) / 2;
        rail.scrollTo({ top: Math.max(0, target), behavior: scrollBehavior });
      }
    }

    onEnded() {
      this.isPlaying = false;
      this.updatePlayButton();
      this.currentSubtitleIndex = -1;
    }
  }

  function initAudioPlayers() {
    const containers = document.querySelectorAll('.audio-mode-container');
    containers.forEach(container => {
      if (!container.dataset.initialized) {
        container.dataset.initialized = 'true';
        new AudioModeController(container);
      }
    });
  }

  document.addEventListener('astro:page-load', initAudioPlayers);
  document.addEventListener('DOMContentLoaded', initAudioPlayers);
</script>
