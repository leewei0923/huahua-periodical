---
import { SITE_TITLE } from '../consts';
import { getCurrentPeriod } from '../lib/periods';
const pathname = Astro.url.pathname;
const isActive = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
const currentWeek = getCurrentPeriod('weekly');
---

<header class="site-header">
	<nav class="nav-shell" aria-label="Primary navigation">
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE}首页`}>
			<span class="wordmark-cn"><span>花花</span><span>有期</span></span>
			<span class="wordmark-dot">●</span>
			<span class="wordmark-en"><span>HUĀHUĀ</span><span>PERIODICAL</span></span>
		</a>
		<div class="nav-links">
			<a class:list={{ active: isActive('/blog') }} href="/blog">文章 <span>Stories</span></a>
			<a class:list={{ active: isActive('/weekly') || isActive('/monthly') || isActive('/yearly') }} href="/weekly">刊期 <span>Issues</span></a>
			<a class:list={{ active: isActive('/picks') }} href="/picks">精选 <span>Picks</span></a>
			<a class:list={{ active: isActive('/submit') }} href="/submit">投稿 <span>Submit</span></a>
			<a class:list={{ active: isActive('/about') }} href="/about">关于 <span>About</span></a>
		</div>
		<div class="nav-meta">
			<div class="controls">
				<button class="theme-toggle" type="button" aria-label="切换到夜间模式" aria-pressed="false" title="切换到夜间模式">
					<span class="theme-track" aria-hidden="true">
						<svg class="sun-icon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
						</svg>
						<svg class="moon-icon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
						</svg>
					</span>
					<span class="sr-only theme-status">当前为日间模式</span>
				</button>
				<button class="focus-toggle" aria-label="切换专注模式" title="阅读专注模式">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
						<circle cx="12" cy="12" r="3"></circle>
					</svg>
				</button>
			</div>
			<span class="issue">{currentWeek.id}</span>
		</div>
	</nav>
</header>

<style>
	.site-header { position: sticky; top: 0; z-index: 20; padding: 0 2rem; background: color-mix(in srgb, var(--bg-soft) 91%, transparent); border-bottom: 1px solid var(--border); backdrop-filter: blur(16px); }
	.nav-shell { max-width: 1280px; min-height: 72px; margin: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
	a { color: var(--fg); text-decoration: none; }
	.wordmark { display: flex; align-items: center; gap: .55rem; width: max-content; }
	.wordmark-cn, .wordmark-en { display: flex; flex-direction: column; line-height: 1.05; }
	.wordmark-cn { font-size: .96rem; font-weight: 700; letter-spacing: .06em; }
	.wordmark-dot { color: var(--accent); font-size: .55rem; }
	.wordmark-en { font-family: var(--font-mono); font-size: .54rem; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-muted); }
	.nav-links { display: flex; align-self: stretch; gap: 1.55rem; }
	.nav-links a { position: relative; display: flex; align-items: center; gap: .5rem; font-size: .95rem; }
	.nav-links a span { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .1em; color: var(--fg-muted); text-transform: uppercase; }
	.nav-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); transform: scaleX(0); transition: transform 180ms var(--ease); }
	.nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); }
	.nav-meta { justify-self: end; display: flex; align-items: center; gap: 1rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; color: var(--fg-muted); }
	.theme-toggle { position: relative; display: inline-flex; width: 58px; height: 32px; padding: 0; color: var(--fg-muted); background: transparent; border: 0; border-radius: 999px; cursor: pointer; }
	.theme-track { position: relative; display: grid; width: 100%; height: 100%; grid-template-columns: 1fr 1fr; align-items: center; padding: 3px; background: var(--bg); border: 1px solid var(--border-strong); border-radius: inherit; box-shadow: inset 0 1px 2px rgba(var(--black), .06); overflow: hidden; }
	.theme-track::before { content: ''; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; background: var(--fg); border-radius: 50%; box-shadow: 0 2px 7px rgba(var(--black), .18); transition: transform 240ms var(--ease), background-color 180ms var(--ease); }
	.theme-toggle svg { position: relative; z-index: 1; width: 15px; height: 15px; justify-self: center; fill: none; stroke-linecap: round; stroke-linejoin: round; transition: color 180ms var(--ease), transform 240ms var(--ease); }
	.theme-toggle .sun-icon { color: var(--bg); transform: rotate(0deg); }
	.theme-toggle .moon-icon { color: var(--fg-muted); transform: rotate(-18deg); }
	[data-theme="dark"] .theme-track::before { transform: translateX(26px); }
	[data-theme="dark"] .theme-toggle .sun-icon { color: var(--fg-muted); transform: rotate(45deg); }
	[data-theme="dark"] .theme-toggle .moon-icon { color: var(--bg); transform: rotate(0deg); }
	.theme-toggle:hover .theme-track { border-color: var(--accent); }
	.theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
	.theme-toggle:active .theme-track::before { transform: scale(.9); }
	[data-theme="dark"] .theme-toggle:active .theme-track::before { transform: translateX(26px) scale(.9); }
	@media (max-width: 760px) {
		.site-header { padding: 0 1rem; }
		.nav-shell { min-height: 58px; grid-template-columns: 1fr auto; gap: .75rem; }
		.nav-links { order: 3; grid-column: 1 / -1; min-height: 42px; justify-content: center; border-top: 1px solid var(--border); }
		.nav-links a { font-size: .78rem; }
		.nav-links a span { display: none; }
		.nav-meta .issue { display: none; }
		.wordmark-en { display: none; }
	}
</style>
